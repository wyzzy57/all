FROM hiyouga/llamafactory@sha256:d1ce6223bf300f3c6bef1bcf02809d3ed4472c1d232a771affd4471d872d6a6b

USER root
RUN pip install --no-cache-dir \
    "psutil>=6,<8" \
    "tensorboard>=2.18,<3" \
    "mlflow-skinny>=3,<4"
COPY workers/llm-training-worker/src/visiox_llm_training_worker /app/visiox_llm_training_worker
ENV PYTHONPATH=/app

HEALTHCHECK NONE
WORKDIR /workspace
