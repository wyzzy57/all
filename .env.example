VISIOX_MAX_DATASET_ZIP_ENTRIES=10000
VISIOX_MAX_DATASET_ZIP_UNCOMPRESSED_BYTES=524288000
VISIOX_REGISTRY_URL=registry:5000
VISIOX_LABEL_STUDIO_URL=http://label-studio:8080
VISIOX_LABEL_STUDIO_TOKEN=
VISIOX_LABEL_STUDIO_SYNC_STREAM=stream:label_sync.commands

POSTGRES_DB=visiox
POSTGRES_USER=visiox
POSTGRES_PASSWORD=visiox

MINIO_ROOT_USER=visiox
MINIO_ROOT_PASSWORD=visiox123

LABEL_STUDIO_DISABLE_SIGNUP_WITHOUT_LINK=true
