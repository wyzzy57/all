VISIOX_ENV=local
VISIOX_POSTGRES_DSN=postgresql+psycopg://visiox:visiox@postgres:5432/visiox
VISIOX_REDIS_URL=redis://redis:6379/0
VISIOX_MINIO_ENDPOINT=minio:9000
VISIOX_MINIO_PUBLIC_URL=http://127.0.0.1:9000
VISIOX_MINIO_ACCESS_KEY=visiox
VISIOX_MINIO_SECRET_KEY=visiox123
VISIOX_MINIO_SECURE=false
VISIOX_MAX_DATASET_UPLOAD_BYTES=104857600
VISIOX_MAX_DATASET_IMAGE_BYTES=26214400
VISIOX_MAX_DATASET_ZIP_ENTRIES=10000
VISIOX_MAX_DATASET_ZIP_UNCOMPRESSED_BYTES=524288000
VISIOX_REGISTRY_URL=registry:5000
VISIOX_LABEL_STUDIO_URL=http://label-studio:8080
VISIOX_LABEL_STUDIO_PUBLIC_URL=http://127.0.0.1:8080
VISIOX_LABEL_STUDIO_TOKEN=visiox-label-studio-token
VISIOX_LABEL_STUDIO_SYNC_STREAM=stream:label_sync.commands
VISIOX_SEED_BASE_MODELS_ON_STARTUP=true
VISIOX_MLFLOW_TRACKING_URI=http://mlflow:5000
VISIOX_MLFLOW_PUBLIC_URL=http://127.0.0.1:5001
VISIOX_TENSORBOARD_PUBLIC_URL=http://127.0.0.1:6006
VISIOX_TENSORBOARD_HISTOGRAM_INTERVAL=5
VISIOX_TRAINING_RUNS_ROOT=/workspace/training-runs
VISIOX_OBSERVABILITY_MAX_POINTS=2000
VISIOX_OBSERVABILITY_EVENT_CACHE_SIZE=32
VISIOX_OBSERVABILITY_LIVE_POLL_SECONDS=5

POSTGRES_DB=visiox
POSTGRES_USER=visiox
POSTGRES_PASSWORD=visiox

MINIO_ROOT_USER=visiox
MINIO_ROOT_PASSWORD=visiox123

LABEL_STUDIO_DISABLE_SIGNUP_WITHOUT_LINK=true
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=visiox123
LABEL_STUDIO_USER_TOKEN=visiox-label-studio-token
