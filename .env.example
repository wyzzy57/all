VISIOX_ENV=local
VISIOX_POSTGRES_DSN=postgresql+psycopg://visiox:visiox@postgres:5432/visiox
VISIOX_REDIS_URL=redis://redis:6379/0
VISIOX_MINIO_ENDPOINT=minio:9000
VISIOX_MINIO_ACCESS_KEY=visiox
VISIOX_MINIO_SECRET_KEY=visiox123
VISIOX_MINIO_SECURE=false
VISIOX_MAX_DATASET_UPLOAD_BYTES=104857600
